# Copy to .env and fill in. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Postgres for staging/prod; leave unset in dev to use api/rysyl.db (SQLite)
DATABASE_URL=postgresql+psycopg://rysyl:rysyl@localhost:5432/rysyl
CORS_ORIGINS=http://localhost:5183,http://localhost:5173
RYSYL_PORT=5001
# MONEY_UNITS is a locked decision: all amounts stored as integer minor units (cents)
MONEY_UNITS=minor
# Email (Sprint 6) — unset disables email; notifications are recorded in DB only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ops@rysyl.group
